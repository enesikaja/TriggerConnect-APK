# ===========================================================================
#  Edge Function secrets. Set these with:
#     supabase secrets set --env-file supabase/functions/.env
#  NEVER commit the real .env (it is gitignored). SUPABASE_URL and
#  SUPABASE_SERVICE_ROLE_KEY are injected automatically by the platform at
#  runtime, so you normally do NOT set them here.
# ===========================================================================

# Keyed-hash secrets (generate with: openssl rand -hex 32)
CODE_HASH_SECRET=replace-with-32-byte-random-hex
INVITE_HASH_SECRET=replace-with-32-byte-random-hex

# Internal email domain for the code-bootstrap auth flow (no mail is ever sent).
AUTH_EMAIL_DOMAIN=users.triggerconnect.app

# Firebase Cloud Messaging service account (FREE Spark plan is fine for FCM).
# Paste the ENTIRE service-account JSON on one line (escaped), e.g.:
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
FCM_SERVICE_ACCOUNT=
